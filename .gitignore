# Build-Artefakte
# Die Muster sind an die Wurzel gebunden (/volt statt volt) — sonst würden sie
# auch die Verzeichnisse cmd/volt/ und cmd/volt-agent/ ausschließen.
/bin/
/dist/
/volt
/volt-agent
coverage.out
coverage.html

# Frontend
/web/node_modules/
/web/dist/

# Das gebaute Frontend ist ein Build-Artefakt; .gitkeep hält das Verzeichnis
# für embed.FS am Leben, damit `go build` auch ohne Node durchläuft.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Lokale Entwicklung
*.db
*.db-wal
*.db-shm
/.env
/tmp/
.DS_Store

# Der private Release-Schlüssel. Wer ihn hat, kann Updates für jede
# Installation ausliefern — er gehört in den Secret-Speicher des Repositorys
# (RELEASE_SIGNING_KEY), nicht hierher. Der öffentliche Teil steht in
# internal/release/release.pub und wird eingebettet.
/release.key
/cosign.key
