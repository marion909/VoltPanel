<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="{{ .Domain | xmlesc }}">
    <domain>{{ .Domain | xmlesc }}</domain>
    <displayName>{{ .Domain | xmlesc }}</displayName>
    <displayShortName>{{ .Domain | xmlesc }}</displayShortName>
    <incomingServer type="imap">
      <hostname>{{ .Host | xmlesc }}</hostname>
      <port>{{ .IMAPPort }}</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>{{ .Host | xmlesc }}</hostname>
      <port>{{ .SMTPPort }}</port>
      <socketType>STARTTLS</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </outgoingServer>
  </emailProvider>
</clientConfig>
