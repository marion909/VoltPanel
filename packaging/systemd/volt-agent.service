[Unit]
Description=VoltPanel Agent (privilegierte Operationen)
Documentation=https://github.com/marion909/VoltPanel
After=network.target
Before=volt-web.service

[Service]
Type=simple
ExecStart=/usr/local/bin/volt-agent --peer-user volt
Restart=always
RestartSec=3

# Der Agent braucht root — das ist sein Zweck. Alles, was er darüber hinaus
# nicht braucht, wird ihm hier weggenommen.
User=root
RuntimeDirectory=volt
RuntimeDirectoryMode=0755

NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# /usr und /boot bleiben schreibgeschützt. /etc dagegen muss offen sein, und
# zwar als Verzeichnis: useradd legt seine Sperrdatei (/etc/passwd.lock) neben
# der Datei an, die es ändert. Einzelne Dateien freizugeben reicht deshalb
# nicht — ohne das Verzeichnis meldet es "cannot lock /etc/passwd".
#
# Dieselbe Freigabe deckt /etc/cron.d ab, wohin jeder Cronjob als eigene Datei
# geht.
#
# Die eigentliche Grenze ist ohnehin eine andere: der Agent kennt nur die
# typisierten Operationen aus internal/agent/protocol.go, und jeder Pfad läuft
# zusätzlich durch das Gefängnis in jail(). Die Einhängung ist die zweite
# Verteidigungslinie, nicht die erste.
ProtectSystem=full
ReadWritePaths=/etc /var/www /var/lib/volt /var/log/volt /var/backups/volt

StandardOutput=journal
StandardError=journal
SyslogIdentifier=volt-agent

[Install]
WantedBy=multi-user.target
