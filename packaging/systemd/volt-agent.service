[Unit]
Description=VoltPanel Agent (privilegierte Operationen)
Documentation=https://github.com/marion909/VoltPanel
After=network.target
Before=volt-web.service

[Service]
Type=simple
ExecStart=/usr/local/bin/volt-agent --peer-user volt
Restart=always
RestartSec=3

# Der Agent braucht root — das ist sein Zweck. Alles, was er darüber hinaus
# nicht braucht, wird ihm hier weggenommen.
User=root
RuntimeDirectory=volt
RuntimeDirectoryMode=0755

NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# ProtectSystem=true und nicht "full": full setzt zusätzlich /etc
# schreibgeschützt, und ein ReadWritePaths=/etc hebt das NICHT auf. Steht
# derselbe Pfad in beiden Listen, gewinnt die restriktivere Angabe — die Unit
# sah dann richtig aus, `systemctl show` zeigte /etc als beschreibbar, und
# useradd scheiterte trotzdem mit "cannot lock /etc/passwd".
#
# Eine Freigabe wirkt nur für echte Unterpfade. So macht es volt-web.service
# mit /etc/volt/keys, und dort funktioniert es.
#
# Der Agent schreibt: /etc (Systembenutzer, nginx, php, cron.d), /var/www,
# /var/lib/volt, /var/log/volt, /var/backups/volt. Unter ProtectSystem=true
# sind die alle ohnehin beschreibbar; aufgezählt werden muss nur, was unter
# /usr liegt.
ProtectSystem=true

# /usr/local/bin, damit `volt update` beide Programme austauschen kann — auch
# das aus der Oberfläche ausgelöste. Ein echter Unterpfad von /usr, die
# Freigabe greift also.
ReadWritePaths=/usr/local/bin

StandardOutput=journal
StandardError=journal
SyslogIdentifier=volt-agent

[Install]
WantedBy=multi-user.target
